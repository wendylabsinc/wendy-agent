{
  "appId": "HelloAudio",
  "version": "0.1.0",
  "platform": "linux",
  "entitlements": [
    {
      "type": "network",
      "mode": "host"
    },
    {
      "type": "audio"
    }
  ],
  "readiness": {
    "tcpSocket": { "port": 3004 },
    "timeoutSeconds": 30
  },
  "hooks": {
    "postStart": {
      "cli": "wendy utils open-browser http://${WENDY_HOSTNAME}:3004"
    }
  }
}