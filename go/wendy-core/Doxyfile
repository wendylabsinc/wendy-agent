PROJECT_NAME           = "Wendy SDK"
PROJECT_BRIEF          = "Cross-platform Wendy SDK C contract"
OUTPUT_DIRECTORY       = .build/sdk/site
INPUT                  = include Documentation .build/sdk/ProtobufReference.md
RECURSIVE              = YES
FILE_PATTERNS           = *.h *.md
USE_MDFILE_AS_MAINPAGE = Documentation/MainPage.md

GENERATE_HTML          = YES
GENERATE_XML           = YES
XML_OUTPUT             = xml
HTML_OUTPUT            = html

EXTRACT_ALL            = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
QUIET                  = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = WENDY_API= WENDY_CALL=
