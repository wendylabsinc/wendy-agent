[
  {
    "name": "redis",
    "image": "docker.io/library/redis:7",
    "description": "In-memory key-value store",
    "category": "Database",
    "defaultConfig": {
      "appId": "redis",
      "version": "7",
      "entitlements": [
        { "type": "network", "ports": [{ "host": 6379, "container": 6379 }] },
        { "type": "persist", "name": "data", "path": "/data" }
      ]
    }
  },
  {
    "name": "postgres",
    "image": "docker.io/library/postgres:16",
    "description": "PostgreSQL relational database",
    "category": "Database",
    "defaultConfig": {
      "appId": "postgres",
      "version": "16",
      "entitlements": [
        { "type": "network", "ports": [{ "host": 5432, "container": 5432 }] },
        { "type": "persist", "name": "data", "path": "/var/lib/postgresql/data" }
      ]
    }
  },
  {
    "name": "homeassistant",
    "image": "ghcr.io/home-assistant/home-assistant:stable",
    "description": "Home Assistant smart-home hub (web UI on :8123)",
    "category": "Home & IoT",
    "defaultConfig": {
      "appId": "homeassistant",
      "version": "stable",
      "entitlements": [
        { "type": "network", "mode": "host" },
        { "type": "persist", "name": "config", "path": "/config" }
      ],
      "hooks": { "postStart": { "openURL": "http://${WENDY_HOSTNAME}:8123" } }
    }
  },
  {
    "name": "mosquitto",
    "image": "docker.io/library/eclipse-mosquitto:2",
    "description": "Eclipse Mosquitto MQTT broker",
    "category": "Home & IoT",
    "defaultConfig": {
      "appId": "mosquitto",
      "version": "2",
      "entitlements": [
        { "type": "network", "ports": [{ "host": 1883, "container": 1883 }] },
        { "type": "persist", "name": "data", "path": "/mosquitto/data" }
      ]
    }
  },
  {
    "name": "grafana",
    "image": "docker.io/grafana/grafana:11.6",
    "description": "Grafana observability dashboards (web UI on :3000)",
    "category": "Observability",
    "defaultConfig": {
      "appId": "grafana",
      "version": "11.6",
      "entitlements": [
        { "type": "network", "ports": [{ "host": 3000, "container": 3000 }] },
        { "type": "persist", "name": "data", "path": "/var/lib/grafana" }
      ],
      "hooks": { "postStart": { "openURL": "http://${WENDY_HOSTNAME}:3000" } }
    }
  },
  {
    "name": "paperless",
    "image": "ghcr.io/paperless-ngx/paperless-ngx:latest",
    "description": "Paperless-ngx document management (web UI on :8000; needs redis)",
    "category": "Documents",
    "defaultConfig": {
      "appId": "paperless",
      "version": "latest",
      "entitlements": [
        { "type": "network", "mode": "host" },
        { "type": "persist", "name": "data", "path": "/usr/src/paperless/data" },
        { "type": "persist", "name": "media", "path": "/usr/src/paperless/media" }
      ],
      "hooks": { "postStart": { "openURL": "http://${WENDY_HOSTNAME}:8000" } }
    }
  }
]
