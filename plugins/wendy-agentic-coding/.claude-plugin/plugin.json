{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "wendy-agentic-coding",
  "description": "Build, deploy, and debug apps on robots and edge devices running WendyOS (NVIDIA Jetson, Raspberry Pi, and more). Claude can set up the Wendy CLI, install a device, create an app from a template, deploy it, read its logs, and capture sensor data with Wendy Data.",
  "version": "0.6.3",
  "author": {
    "name": "Wendy Labs",
    "url": "https://github.com/wendylabsinc"
  },
  "homepage": "https://github.com/wendylabsinc/wendy-agentic-coding",
  "repository": "https://github.com/wendylabsinc/wendy-agentic-coding",
  "license": "Apache-2.0",
  "keywords": [
    "wendy",
    "wendyos",
    "wendy-json",
    "wendy-data",
    "data-campaigns",
    "entitlements",
    "build-run",
    "device-ops",
    "mcp",
    "agentic-coding",
    "claude-code",
    "templates"
  ],
  "skills": "./skills/",
  "commands": "./commands/",
  "mcpServers": {
    "wendy": {
      "command": "wendy",
      "args": ["mcp", "serve"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
