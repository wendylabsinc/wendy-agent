{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wendy-relay": {
      "type": "streamable-http",
      "url": "https://mcp.wendy.dev",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "mcp:relay"
            ],
            "defaultScopes": [],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
