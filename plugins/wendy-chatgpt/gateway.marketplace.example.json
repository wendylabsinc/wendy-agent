{
  "state_directory": "/var/lib/wendy-chatgpt",
  "robots": [],
  "grants": [],
  "http": {
    "resource_url": "https://mcp.wendy.dev",
    "cloud_link": {
      "services": {
        "auth_base": "https://auth.wendy.dev",
        "client_id": "wendy-chatgpt-gateway",
        "identity_resource": "https://pki.wendy.sh/identity",
        "identity_endpoint": "https://identity.pki.wendy.dev/v1/identity/certificate",
        "cloud_resource": "https://cloud.wendy.dev/api",
        "cloud_grpc": "api.wendy.dev:443",
        "relay_issuer": "https://api.wendy.dev"
      },
      "state_file": "/var/lib/wendy-chatgpt/accounts.enc",
      "encryption_key_env": "WENDY_CHATGPT_STATE_KEY",
      "clients": [
        {
          "id": "wendy-chatgpt",
          "name": "ChatGPT",
          "redirect_uris": [
            "https://chatgpt.com/connector_platform_oauth_redirect"
          ]
        }
      ],
      "scopes": [
        "robots:read",
        "cameras:capture",
        "apps:control",
        "preferences:write"
      ],
      "allow_camera": true,
      "allow_all_apps": true
    }
  }
}
