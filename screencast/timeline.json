{
  "$schema": "./timeline.schema.json",
  "engine": "slidev",
  "deck": "deck/slides.md",
  "size": {
    "width": 1440,
    "height": 900,
    "fps": 10
  },
  "steps": [
    { "id": "title", "target": "1", "minSeconds": 10.0, "voiceover": "voiceover/mp3/00-title.mp3" },
    { "id": "problem", "target": "2", "minSeconds": 10.0, "voiceover": "voiceover/mp3/01-problem.mp3" },
    { "id": "linear-layers", "target": "3", "minSeconds": 13.0, "voiceover": "voiceover/mp3/02-linear-layers.mp3" },
    { "id": "workaround", "target": "4", "minSeconds": 13.0, "voiceover": "voiceover/mp3/03-workaround.mp3" },
    { "id": "one-cable", "target": "5", "minSeconds": 8.0, "voiceover": "voiceover/mp3/04-one-cable.mp3" },
    { "id": "what-it-does", "target": "6", "minSeconds": 15.0, "voiceover": "voiceover/mp3/05-what-it-does.mp3" },
    { "id": "config", "target": "7", "minSeconds": 14.0, "voiceover": "voiceover/mp3/06-config.mp3" },
    { "id": "developer-flow", "target": "8", "minSeconds": 15.0, "voiceover": "voiceover/mp3/07-developer-flow.mp3", "media": "deck/public/videos/file-sync/07-developer-flow.mp4" },
