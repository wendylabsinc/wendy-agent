# Dependencies and local Slidev outputs
node_modules/
.slidev/
dist/

# Demo/runtime state
demo/.wendy-demo-first-run

# Generated or captured media embedded by the deck
deck/public/videos/*
!deck/public/videos/.gitkeep
deck/public/images/*
!deck/public/images/.gitkeep

# Generated voiceover audio
voiceover/mp3/*
!voiceover/mp3/.gitkeep

# Final renders and temporary build outputs
output/*
!output/.gitkeep
build/

# Legacy generated media from earlier drafts
recordings/*
slides/*.png
stitch/
title-card.png
closing-card.png

# Local bytecode and OS metadata
__pycache__/
*.pyc
.DS_Store
