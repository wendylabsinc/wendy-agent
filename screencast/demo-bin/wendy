#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "run" ]]; then
  device="lab-edge-01"
  if [[ "${2:-}" == "--device" && -n "${3:-}" ]]; then
    device="$3"
  fi
  app_id="sh.wendy.demo.filesync"
  prompt_hash="$(shasum -a 256 prompts/system.txt | awk '{print substr($1,1,12)}')"
  config_size="$(wc -c < config/runtime.json | tr -d ' ')"
  sample_size="$(wc -c < fixtures/sample-input.json | tr -d ' ')"
  if [[ -f .wendy-demo-first-run ]]; then
    cat <<OUT
Resolving target ${device}
Building application image
✓ Reused cached image layers
Syncing wendy.json files for ${app_id}
  changed prompts/system.txt (${prompt_hash})
  unchanged config/runtime.json (${config_size} bytes)
  unchanged fixtures/sample-input.json (${sample_size} bytes)
  removed stale calibration/old-profile.json
✓ Synced 3 deployment inputs
Starting ${app_id}
app stdout: prompt=$(tr -d '\n' < prompts/system.txt)
app stdout: threshold=0.82
app stdout: sample=sample-042
OUT
  else
    touch .wendy-demo-first-run
    cat <<OUT
Resolving target ${device}
Building application image
✓ Built sh.wendy.demo.filesync:latest
Syncing wendy.json files for ${app_id}
  prompts/system.txt -> prompts/system.txt (${prompt_hash})
  config/runtime.json -> config/runtime.json (${config_size} bytes)
  fixtures/sample-input.json -> data/sample-input.json (${sample_size} bytes)
✓ Synced 3 deployment inputs as read-only runtime inputs
Starting ${app_id}
app stdout: prompt=$(tr -d '\n' < prompts/system.txt)
app stdout: threshold=0.82
app stdout: sample=sample-042
OUT
  fi
  exit 0
fi

if [[ "${1:-}" == "--device" && "${3:-}" == "device" && "${4:-}" == "apps" && "${5:-}" == "remove" ]]; then
  app_id="${7:-sh.wendy.demo.filesync}"
  rm -f .wendy-demo-first-run
  cat <<OUT
Stopping ${app_id}
Removing app record
Deleting synced deployment inputs for ${app_id}
✓ Removed ${app_id}
OUT
  exit 0
fi

echo "wendy demo stub: unsupported arguments: $*" >&2
exit 2
