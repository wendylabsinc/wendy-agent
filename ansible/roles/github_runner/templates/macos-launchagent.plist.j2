<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.actions.runner.{{ github_runner_name }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ github_runner_dir }}/run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{ github_runner_dir }}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{ github_runner_dir }}/runner.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>{{ github_runner_dir }}/runner.stderr.log</string>
</dict>
</plist>
