# Copy to fleet.toml, adjust, then audit with `python3 fleet.py render`
# before running `python3 fleet.py up`.

[fleet]
# A template name under Training/templates/, or a path (relative to this
# file) to any directory containing a wendy.json.
template = "es-fleet"

# Transport for peer addressing, default "mesh". "lan" is a fallback for
# fleets where the mesh overlay is unreliable (for example mixed agent
# versions): it rewrites the staged wendy.json's network entitlement to
# host mode and renders MESH_PEERS as hostname:port entries.
# transport = "mesh"

devices = ["spark-3011.local", "spark-48fd.local", "spark-edeb.local"]

# Asset ids are resolved via `wendy cloud device list --json` and cached in
# .fleet-state.json next to this file. To pin ids or roles per device, use
# tables instead; role overrides must leave exactly one coordinator:
# devices = [
#   { host = "spark-3011.local", asset_id = 334, role = "coordinator" },
#   { host = "spark-48fd.local", asset_id = 211, role = "worker" },
#   { host = "spark-edeb.local", asset_id = 283, role = "worker" },
# ]

[env]
# Forwarded verbatim to every device, on top of the computed per-device
# MESH_SELF, MESH_PEERS, and WT_ROLE.
WT_RUN_ID = "demo-1"
ES_POP = "64"

# Only the sweep template reads this section; one entry per device, matched
# by position. Each member receives WT_SWEEP_INDEX and WT_SWEEP_PARAMS.
# [sweep]
# params = [{ seed = 1 }, { seed = 2 }, { seed = 3 }]
