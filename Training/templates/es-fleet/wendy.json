{
    "appId": "sh.wendy.training.es-fleet",
    "platform": "linux",
    "version": "1.0.0",
    "isolation": "isolated",
    "services": {
        "trainer": {
            "context": ".",
            "entitlements": [
                {
                    "type": "network",
                    "mode": "mesh",
                    "serviceCIDR": "10.99.0.0/16",
                    "ports": [
                        {
                            "host": 8080,
                            "container": 8080
                        }
                    ]
                },
                {
                    "type": "persist",
                    "name": "wt-es-ckpt",
                    "path": "/data/checkpoints"
                }
            ],
            "env": {
                "MESH_PEERS": "${MESH_PEERS}",
                "MESH_SELF": "${MESH_SELF}",
                "MESH_PORT": "${MESH_PORT}",
                "WT_ROLE": "${WT_ROLE}",
                "WT_RUN_ID": "${WT_RUN_ID}",
                "WT_CKPT_DIR": "${WT_CKPT_DIR}",
                "WT_CONFIG": "${WT_CONFIG}",
                "ES_POP": "${ES_POP}",
                "ES_SIGMA": "${ES_SIGMA}",
                "ES_LR": "${ES_LR}",
                "ES_GEN_TIMEOUT_S": "${ES_GEN_TIMEOUT_S}",
                "ES_MAX_GENERATIONS": "${ES_MAX_GENERATIONS}",
                "ES_CHECKPOINT_EVERY": "${ES_CHECKPOINT_EVERY}",
                "ES_SEED": "${ES_SEED}",
                "ES_COORDINATOR": "${ES_COORDINATOR}",
                "ES_WORKER_INDEX": "${ES_WORKER_INDEX}",
                "ES_WORKER_COUNT": "${ES_WORKER_COUNT}",
                "WT_COORDINATOR": "${WT_COORDINATOR}",
                "WT_NODE_INDEX": "${WT_NODE_INDEX}",
                "WT_NODE_COUNT": "${WT_NODE_COUNT}"
            }
        }
    }
}
